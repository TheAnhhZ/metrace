<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: The metrace Authors
SPDX-License-Identifier: Apache-2.0

Test fixture (kept from the W0 spike): external-worker callback, then a user
task guarded by a 10 s boundary timer that escalates to a second user task.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="https://metrace.example/bpmn/test">
  <process id="spike-timer-escalation" name="Spike: timer escalation" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="notifyApp"/>

    <serviceTask id="notifyApp" name="Notify app" flowable:type="external-worker" flowable:topic="metrace-spike"/>
    <sequenceFlow id="f2" sourceRef="notifyApp" targetRef="review"/>

    <userTask id="review" name="QA review" flowable:candidateGroups="qa"/>
    <boundaryEvent id="reviewTimeout" attachedToRef="review" cancelActivity="true">
      <timerEventDefinition>
        <timeDuration>${reviewTimeout}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="f3" sourceRef="review" targetRef="done"/>
    <sequenceFlow id="f4" sourceRef="reviewTimeout" targetRef="escalate"/>

    <userTask id="escalate" name="Director escalation" flowable:candidateGroups="director"/>
    <sequenceFlow id="f5" sourceRef="escalate" targetRef="escalated"/>

    <endEvent id="done"/>
    <endEvent id="escalated"/>
  </process>
</definitions>
