    },
    {
      "name": "Nha may X", "alias": "nha-may-x", "enabled": true,
      "domains": [{ "name": "nha-may-x.metrace.test", "verified": false }],
      "members": [{ "username": "nha-may-x", "membershipType": "UNMANAGED" }]
    }
  ]
}
