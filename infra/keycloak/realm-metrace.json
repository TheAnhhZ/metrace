      "realmRoles": ["cskh"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "director-nam", "firstName": "Nam", "lastName": "Director", "enabled": true,
      "realmRoles": ["director"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "truong-a", "firstName": "Truong A", "lastName": "Staff", "enabled": true,
      "realmRoles": ["customer_staff"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "truong-b", "firstName": "Truong B", "lastName": "Staff", "enabled": true,
      "realmRoles": ["customer_staff"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "truong-c", "firstName": "Truong C", "lastName": "Staff", "enabled": true,
      "realmRoles": ["customer_staff"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "nha-may-x", "firstName": "Nha may X", "lastName": "Staff", "enabled": true,
      "realmRoles": ["customer_staff"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
    }
  ],
  "organizations": [
    {
      "name": "Truong A", "alias": "truong-a", "enabled": true,
      "domains": [{ "name": "truong-a.metrace.test", "verified": false }],
      "members": [{ "username": "truong-a", "membershipType": "UNMANAGED" }]
