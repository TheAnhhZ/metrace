    },
    {
      "username": "driver-tuan", "firstName": "Tuan", "lastName": "Driver", "enabled": true,
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }]
