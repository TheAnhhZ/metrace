# Reference only. Run `make init` to generate a real .env with random secrets.
POSTGRES_PASSWORD=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME
FLOWABLE_DB_PASSWORD=CHANGE_ME
METRACE_MIGRATOR_PASSWORD=CHANGE_ME
METRACE_APP_PASSWORD=CHANGE_ME
KC_ADMIN_PASSWORD=CHANGE_ME
METRACE_API_CLIENT_SECRET=CHANGE_ME
SENSOR_GATEWAY_CLIENT_SECRET=CHANGE_ME
FLOWABLE_ADMIN_PASSWORD=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
DEMO_USER_PASSWORD=CHANGE_ME
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_READINGS_PER_MIN=1200
# Keycloak overlays applied by kc-bootstrap: "test" adds the CI-only client
# metrace-test (direct access grants); "demo" relaxes SSO idle for live demos.
KC_OVERLAYS=test
